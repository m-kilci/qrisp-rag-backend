# Replace the host with your Windows desktop's LAN address for remote Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional documentation source directory; defaults to ~/projects/Qrisp/documentation/source.
# The rendered reference pages must be in the sibling ../build/html/reference directory.
QRISP_DOCS_ROOT=~/projects/Qrisp/documentation/source

# Comma-separated frontend origins; restart the backend after changing this.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
